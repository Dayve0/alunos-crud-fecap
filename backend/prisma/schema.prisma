generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model students {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  course    String
  status    String
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
}
